# Bayyina - environment template
# Copy to .env and fill in. NEVER commit .env.

# --- Environment -------------------------------------------------------------
BAYYINA_ENV=local                      # local | production
BAYYINA_BASE_URL=http://localhost:8000 # public base URL; used in SMS pack links
LOG_LEVEL=INFO                         # applied to the 'bayyina' logger tree

# --- Paths -------------------------------------------------------------------
RULES_DIR=rules
DATA_DIR=data
FRONTEND_DIST=static                   # built frontend; absent in dev, where Vite serves it

# --- Rule and data guardrails ------------------------------------------------
# Freshness has two thresholds, both measured from the newest contract in the
# release - never from when we processed it. Measured drift per cell: 3.4% at
# three months, 4.3% at six, 6.1% at twelve. The rent-cap bands are five
# percentage points wide, so past a year a stale median can flip a verdict.
MARKET_SNAPSHOT_FRESH_DAYS=120         # under this, quote the figure plainly
MARKET_SNAPSHOT_MAX_AGE_DAYS=365       # past this, there is nothing to quote
                                       # between them: quoted, with the age said aloud
MIN_CONTRACTS_FOR_ANSWER=10            # G5: below this, HUMAN_REVIEW_REQUIRED
MIN_CONTRACTS_FOR_FULL_CONFIDENCE=30   # G5: below this, reduced confidence
# NOTE: the 90-day notice period is NOT configurable here. It is a property
# of Law 26/2007 Art.14 and lives in the signed rule file, covered by the
# signature. A law is not an environment variable.

# --- Twilio (Phase 3) --------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+971500000000
TWILIO_WHATSAPP_FROM=whatsapp:+971500000000
TWILIO_TIMEOUT_SECONDS=5

# --- ElevenLabs (Phase 3) ----------------------------------------------------
ELEVENLABS_API_KEY=your_key_here
ELEVENLABS_AGENT_ID=your_agent_id_here
ELEVENLABS_WEBHOOK_SECRET=shared_secret_for_verifying_inbound_tool_calls

# --- Limits ------------------------------------------------------------------
PUBLIC_RATE_LIMIT_PER_MINUTE=30        # web checker abuse guard
TOOL_TIMEOUT_SECONDS=3                 # agent-facing webhooks; see T2.10
